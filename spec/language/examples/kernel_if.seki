module seki::fixtures::kernel_if @ 1
profile: c11_bounded @ 1
claims: semantic_evaluation, publication
requires: type_well_formed, totality, determinism, resource_bounds,
  rejection_precedence, publication_equivalence.

export variant Rejection [ No @ 0. ].

export kernel choose flag: Bool value: U32
-> Decision[U32, Rejection]
arithmetic: checked
bounded steps: 16 liveBits: 256 controlDepth: 16 workspaceBits: 0
rejects: Rejection::No
publication: eligible [
  flag ifTrue: [ accept value ] ifFalse: [ reject Rejection::No ]
].
