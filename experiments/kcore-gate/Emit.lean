/-
Build-time driver for the spike (never shipped).

    emit text <file>          canonical KCore program text (its SHA-256 is the program identity)
    emit c <dir> <programId>  kc_u0.h and kc_u0.c through KCore's printer
    emit check <dir>          KCore's independent checker on the emitted files
    emit adapter <dir>        the Seki-facing header and adapter over kc_u0
    emit vectors <file>       differential vectors from the Lean statement of the kernel
-/
import SekiSpike.Gate
import KCore.C11.Print
import KCore.C11.Check

open KCore KCore.C11 SekiSpike.Gate

/-! ## Seki-facing adapter

The KCore unit exposes `struct kc_u0_s1` (the request) and `struct kc_u0_s2`
(the decision) with closed field names `f0 …`. A consumer integrates against
Seki's names and Seki's octet arrays instead, so Seki generates a thin adapter.
It is not covered by KCore's checker: it is new trusted glue, and one of the
spike's findings. -/

def adapterHeader : String := "\n".intercalate [
  "/* Generated by the Seki KCore spike. Seki decision ABI revision 3 (union-free). */",
  "#ifndef SEKI_A0_GATE_H",
  "#define SEKI_A0_GATE_H",
  "",
  "#include <stdint.h>",
  "",
  "typedef struct {",
  "  uint8_t seki_f_account[32];",
  "  uint8_t seki_f_age;",
  "  uint8_t seki_f_boundAccount[32];",
  "  uint16_t seki_f_tier;",
  "} seki_a0_gate_request;",
  "",
  "/* No union and no payload overlap: every payload field of every case has",
  "   its own member, zero when that case is not the decision. */",
  "typedef struct {",
  "  uint32_t abi_revision;",
  "  uint32_t disposition;",
  "  uint32_t rejection_tag;",
  "  uint32_t premise_tag;",
  "  uint16_t tiertoolow_limit;",
  "  uint16_t tiertoolow_actual;",
  "} seki_a0_gate_decision;",
  "",
  "_Static_assert(sizeof(seki_a0_gate_decision) == 20, \"decision has no padding\");",
  "",
  "seki_a0_gate_decision seki_a0_gate_authorise(seki_a0_gate_request request);",
  "",
  "#endif",
  ""]

def adapterSource : String :=
  let bytes (dst src : String) : List String :=
    (List.range 32).map fun i => s!"  in.{dst}.f{i} = request.{src}[{i}];"
  "\n".intercalate ([
    "/* Generated by the Seki KCore spike. Adapter from Seki's ABI to KCore unit 0. */",
    "#include \"seki_a0_gate.h\"",
    "#include \"kc_u0.h\"",
    "",
    "seki_a0_gate_decision seki_a0_gate_authorise(seki_a0_gate_request request) {",
    "  struct kc_u0_s1 in;",
    "  struct kc_u0_s2 out;",
    "  seki_a0_gate_decision d = {0, 0, 0, 0, 0, 0};",
    "  kc_ctx ctx;"] ++
    bytes "f0" "seki_f_account" ++
    ["  in.f1 = request.seki_f_age;"] ++
    bytes "f2" "seki_f_boundAccount" ++
    ["  in.f3 = request.seki_f_tier;",
     "  kc_rt_init(&ctx, 0, 0);",
     "  /* The kernel has no allocation and no checkpoint: KC_OK on every input",
     "     (gate_run). Anything else leaves d zeroed, i.e. disposition 0. */",
     "  if (kc_u0_entry(&ctx, in, &out) == KC_OK) {",
     "    d.abi_revision = out.f0;",
     "    d.disposition = out.f1;",
     "    d.rejection_tag = out.f2;",
     "    d.premise_tag = out.f3;",
     "    d.tiertoolow_limit = out.f4;",
     "    d.tiertoolow_actual = out.f5;",
     "  }",
     "  kc_rt_dispose(&ctx);",
     "  return d;",
     "}",
     ""])

/-! ## Differential vectors -/

/-- A deterministic generator: 64-bit LCG. -/
def lcg (s : Nat) : Nat := (s * 6364136223846793005 + 1442695040888963407) % 2 ^ 64

def bytesFrom (s : Nat) : Nat → List Nat × Nat
  | 0 => ([], s)
  | n + 1 =>
      let s' := lcg s
      let (rest, s'') := bytesFrom s' n
      ((s' / 2 ^ 56) :: rest, s'')

def hex2 (n : Nat) : String :=
  let d := "0123456789abcdef".toList
  String.ofList [d[n / 16]!, d[n % 16]!]

def line (r : Spec.Request) : String :=
  let (disp, tag, prem, lim, act) := match Spec.authorise r with
    | .accept => (1, 0, 0, 0, 0)
    | .reject d p => match d with
      | .tierTooLow l a => (2, d.tag, p, l, a)
      | _ => (2, d.tag, p, 0, 0)
  String.join (r.account.map hex2) ++ " " ++ String.join (r.boundAccount.map hex2) ++
    s!" {r.age} {r.tier} {disp} {tag} {prem} {lim} {act}"

/-- Boundary cases for every premise, every single-octet difference, and a
    pseudo-random sweep in which the two accounts agree half the time. -/
def vectors : List Spec.Request := Id.run do
  let base := (List.range 32).map (· * 7 % 256)
  let mut out : List Spec.Request := []
  for age in [0, 1, 17, 18, 19, 254, 255] do
    for tier in [0, 1, 99, 100, 101, 65534, 65535] do
      out := ⟨base, age, base, tier⟩ :: out
  for i in List.range 32 do
    for delta in [1, 128, 255] do
      let other := base.set i ((base[i]! + delta) % 256)
      out := ⟨base, 18, other, 100⟩ :: ⟨other, 0, base, 0⟩ :: out
  let mut s := 20260926
  for k in List.range 4000 do
    let (a, s1) := bytesFrom s 32
    let (b, s2) := bytesFrom s1 32
    let s3 := lcg s2
    let s4 := lcg s3
    out := ⟨a, s3 / 2 ^ 56, (if k % 2 = 0 then a else b), s4 / 2 ^ 48⟩ :: out
    s := s4
  return out.reverse

def main (args : List String) : IO UInt32 := do
  match args with
  | ["text", file] =>
      IO.FS.writeFile file (Encode.program prog); pure 0
  | ["c", dir, pid] =>
      match lower prog L "authorise" with
      | .error e => IO.eprintln s!"printer refused: {e}"; pure 1
      | .ok u =>
          IO.FS.writeFile s!"{dir}/kc_u0.h" (renderHeader 0 u pid)
          IO.FS.writeFile s!"{dir}/kc_u0.c" (renderSource 0 u pid)
          pure 0
  | ["check", dir] =>
      let h ← IO.FS.readFile s!"{dir}/kc_u0.h"
      let c ← IO.FS.readFile s!"{dir}/kc_u0.c"
      match C11Check.check 0 prog L "authorise" h c with
      | .ok () => IO.println "kcore_c11_check=verified unit=0 program=authorise"; pure 0
      | .error e => IO.eprintln s!"kcore_c11_check=REJECTED: {e}"; pure 1
  | ["adapter", dir] =>
      IO.FS.writeFile s!"{dir}/seki_a0_gate.h" adapterHeader
      IO.FS.writeFile s!"{dir}/seki_a0_gate.c" adapterSource
      pure 0
  | ["vectors", file] =>
      IO.FS.writeFile file ("\n".intercalate (vectors.map line) ++ "\n"); pure 0
  | _ => IO.eprintln "usage: emit text|c|check|adapter|vectors …"; pure 2
