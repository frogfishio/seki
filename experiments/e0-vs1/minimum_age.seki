module seki::experiments::minimum_age @ 1
profile: c11_bounded @ 1
claims: semantic_evaluation, lean_projection, restricted_c_source
requires: type_well_formed, totality, determinism, resource_bounds,
  rejection_precedence.

export record Applicant {
  age: U8
}.

export variant Rejection [
  Underage @ 1.
].

export kernel decide applicant: Applicant
-> Decision[Unit, Rejection]
arithmetic: checked
bounded steps: 32 liveBits: 256 controlDepth: 16 workspaceBits: 0
rejects: Rejection::Underage
publication: none [
  (applicant age) < 18
    ifTrue: [ reject Rejection::Underage ]
    ifFalse: [ accept unit ]
].
